{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "luma",
  "name": "Sherlock",
  "description": "Sherlock documentation: send logs, traces, and metrics from your services and follow a spike from a chart to a trace to the logs.",
  "colors": {
    "primary": "#262626",
    "light": "#E5E5E5",
    "dark": "#171717"
  },
  "fonts": {
    "family": "Geist"
  },
  "background": {
    "color": {
      "light": "#FFFFFF",
      "dark": "#0A0A0A"
    }
  },
  "logo": {
    "light": "/logo/light.png",
    "dark": "/logo/dark.png"
  },
  "favicon": "/favicon.ico",
  "navbar": {
    "primary": {
      "type": "button",
      "label": "Open Sherlock",
      "href": "https://sherlocklabs.dev"
    }
  },
  "footer": {
    "socials": {
      "github": "https://github.com/sherlock-labs-dev"
    }
  },
  "contextual": {
    "options": [
      "copy",
      "view",
      "chatgpt",
      "claude",
      "perplexity",
      "mcp",
      "cursor",
      "vscode"
    ]
  },
  "navigation": {
    "pages": [
      "index",
      "get-started/getting-started",
      "explore/mcp",
      {
        "group": "Send data",
        "icon": "paper-plane",
        "pages": [
          "send-data/overview",
          "send-data/otlp"
        ]
      },
      {
        "group": "Node.js SDK",
        "icon": {
          "style": "brands",
          "name": "node-js"
        },
        "pages": [
          "sdk/nodejs/overview",
          "sdk/nodejs/quickstart",
          "sdk/nodejs/add-telemetry",
          "sdk/nodejs/custom-metrics",
          "sdk/nodejs/manual-spans",
          "sdk/nodejs/troubleshooting"
        ]
      },
      "explore/logs",
      "explore/traces",
      "explore/metrics",
      "explore/exemplars",
      "explore/alerts"
    ]
  }
}
