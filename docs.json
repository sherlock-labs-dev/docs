{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "luma",
  "name": "Sherlock",
  "colors": {
    "primary": "#1F5A8A",
    "light": "#5FA8E6",
    "dark": "#0B3A5C"
  },
  "favicon": "/favicon.png",
  "navigation": {
    "pages": [
      {
        "group": "Getting Started",
        "pages": [
          "index",
          "quickstart"
        ]
      }
    ],
    "tabs": [
      {
        "tab": "Docs",
        "icon": "book",
        "pages": [
          "index",
          "index",
          "get-started/getting-started",
          "explore/mcp",
          {
            "group": "Send data",
            "icon": "paper-plane",
            "pages": [
              "send-data/overview",
              "send-data/otlp"
            ]
          },
          {
            "group": "Node.js SDK",
            "icon": {
              "style": "brands",
              "name": "node-js"
            },
            "pages": [
              "sdk/nodejs/overview",
              "sdk/nodejs/quickstart",
              "sdk/nodejs/add-telemetry",
              "sdk/nodejs/custom-metrics",
              "sdk/nodejs/manual-spans",
              "sdk/nodejs/troubleshooting"
            ]
          },
          "explore/logs",
          "explore/traces",
          "explore/metrics",
          "explore/exemplars",
          "explore/alerts"
        ]
      }
    ]
  },
  "logo": {
    "light": "/logo/light.png",
    "dark": "/logo/dark.png"
  },
  "navbar": {
    "primary": {
      "type": "button",
      "label": "Open Sherlock",
      "href": "https://sherlocklabs.dev"
    }
  },
  "contextual": {
    "options": [
      "copy",
      "view",
      "chatgpt",
      "claude",
      "perplexity",
      "mcp",
      "cursor",
      "vscode"
    ]
  },
  "footer": {
    "socials": {
      "github": "https://github.com/sherlock-labs-dev"
    }
  },
  "description": "Sherlock documentation: send logs, traces, and metrics from your services and follow a spike from a chart to a trace to the logs."
}
